APP_ENV=local
APP_REGION=local
LOG_LEVEL=INFO
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8000
AGENT_FLEET_HOST=127.0.0.1
AGENT_FLEET_PORT=8200
TOOL_GATEWAY_HOST=127.0.0.1
TOOL_GATEWAY_PORT=8300
# Required only when running the Tool Gateway. Generate at least 32 random characters.
TOOL_GATEWAY_AUTH_SECRET=
EVENT_GATEWAY_HOST=127.0.0.1
EVENT_GATEWAY_PORT=8400
# Required only when running the Event Gateway. Generate at least 32 random characters.
EVENT_GATEWAY_WEBHOOK_SECRET=
EVENT_RATE_LIMIT_PER_MINUTE=60
EVENT_MAX_REQUEST_BYTES=262144
WORKFLOW_COORDINATOR_HOST=127.0.0.1
WORKFLOW_COORDINATOR_PORT=8500
WORKFLOW_CALLBACK_URL=http://127.0.0.1:8500/internal/v1/approval-callbacks
# Required for authenticated approval resumption. Generate at least 32 random characters.
WORKFLOW_CALLBACK_SECRET=
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_RETRY_BASE_SECONDS=0.25
AGENT_FLEET_BASE_URL=http://127.0.0.1:8200
TOOL_GATEWAY_BASE_URL=http://127.0.0.1:8300
CONTROL_API_BASE_URL=http://127.0.0.1:8000
EVENT_GATEWAY_BASE_URL=http://127.0.0.1:8400
WORKFLOW_COORDINATOR_BASE_URL=http://127.0.0.1:8500
AGENT_MODEL_MODE=fake
AGENT_MODEL_TIMEOUT_SECONDS=30
CATALOG_BASE_URL=http://127.0.0.1:8100
CRM_BASE_URL=http://127.0.0.1:8101
ANALYTICS_BASE_URL=http://127.0.0.1:8102
SUPPORT_BASE_URL=http://127.0.0.1:8103
CONTROL_TOWER_ORIGIN=http://127.0.0.1:3000
CONTROL_TOWER_ENVIRONMENT=sandbox
CONTROL_TOWER_SANDBOX_ACTIONS_ENABLED=false
PRODUCTION_WRITES_ENABLED=false
PERSISTENCE_BACKEND=memory

# Managed Google Cloud adapters are disabled by default for local development.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
FIRESTORE_DATABASE=(default)
PUBSUB_CHANGE_TOPIC=changeops-change-events
PUBSUB_CHANGE_SUBSCRIPTION=changeops-workflow-coordinator
PUBSUB_DEAD_LETTER_TOPIC=changeops-change-events-dlq
PUBSUB_DEAD_LETTER_SUBSCRIPTION=changeops-change-events-dlq-inspection
WORKFLOW_NAME=
ARTIFACT_BUCKET=
MODEL_ARMOR_TEMPLATE=
AGENT_REGISTRY_LOCATION=
AGENT_GATEWAY_ENDPOINT=
MEMORY_BANK_ID=
GOVERNANCE_BACKEND=local
AGENT_IDENTITY_MODE=local
# Managed Agent Identity prefix, or use the scoped service-account fallback below.
AGENT_IDENTITY_PREFIX=
AGENT_SERVICE_ACCOUNT_DOMAIN=
OTEL_EXPORTER_OTLP_ENDPOINT=
AUTH_AUDIENCE=enterprise-changeops-tool-gateway
DEMO_TENANT_ID=
# For managed-cloud-check, this must match the scope of a synthetic Memory Bank record.
